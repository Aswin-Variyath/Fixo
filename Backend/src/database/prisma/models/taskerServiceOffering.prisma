model TaskerServiceOffering {
  id              String                      @id @default(uuid())
  taskerProfileId String
  serviceId       String
  hourlyRate      Decimal?                    @db.Decimal(10, 2)
  dailyRate       Decimal?                    @db.Decimal(10, 2)
  status          TaskerServiceOfferingStatus @default(ACTIVE)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  taskerProfile TaskerProfile @relation(fields: [taskerProfileId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])

  @@unique([taskerProfileId, serviceId])
  @@index([taskerProfileId, status])
  @@index([serviceId, status])
}
