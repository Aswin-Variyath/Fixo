model TaskerAvailability {
  id              String                   @id @default(uuid())
  taskerProfileId String
  dayOfWeek       DayOfWeek
  startTime       String
  endTime         String
  status          TaskerAvailabilityStatus @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  taskerProfile TaskerProfile @relation(fields: [taskerProfileId], references: [id])

  @@unique([taskerProfileId, dayOfWeek, startTime, endTime])
  @@index([taskerProfileId, dayOfWeek, status])
}
