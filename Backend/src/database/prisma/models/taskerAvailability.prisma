model TaskerAvailability {
  id         String @id @default(uuid())
  scheduleId String

  date      DateTime @db.Date
  startTime String
  endTime   String

  status TaskerAvailabilityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule TaskerAvailabilitySchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, date, startTime, endTime])
  @@index([scheduleId, date, status])
}
